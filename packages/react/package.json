{
  "name": "@tryonit/react",
  "version": "0.1.0",
  "description": "React components and hooks for TryOnIt, the free open-source virtual try-on SDK. Drop-in <TryOnButton> for e-commerce product pages: virtual makeup, glasses, hats, jewelry, watches and clothing. Works with Next.js, Remix and Vite. Fully themeable and headless.",
  "license": "MIT",
  "author": "arbab-naseer (https://github.com/ArbabNaseer82)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "virtual-try-on",
    "try-on",
    "react-component",
    "nextjs",
    "remix",
    "ar",
    "augmented-reality",
    "virtual-makeup",
    "glasses-try-on",
    "jewelry-try-on",
    "ecommerce",
    "shopify",
    "headless",
    "hooks",
    "mediapipe",
    "webgl"
  ],
  "homepage": "https://github.com/ArbabNaseer82/try-it-on/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArbabNaseer82/try-it-on.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/ArbabNaseer82/try-it-on/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/tryonit.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/copy-file.mjs src/styles/tryonit.css dist/tryonit.css && node ../../scripts/copy-file.mjs ../../LICENSE LICENSE",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && node ../../scripts/prepublish-check.mjs"
  },
  "dependencies": {
    "@tryonit/core": "workspace:^",
    "@tryonit/web": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
