{
  "name": "@tryonit/web",
  "version": "0.1.0",
  "description": "Client-side virtual try-on engine for the browser: real-time makeup, glasses, hats, earrings, watches, rings, hair color and clothing overlays using MediaPipe and WebGL. Framework-free mount() for Vue, Svelte, Angular and plain HTML.",
  "license": "MIT",
  "author": "TryOnIt contributors",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "virtual-try-on",
    "try-on",
    "ar",
    "webar",
    "augmented-reality",
    "virtual-makeup",
    "glasses-try-on",
    "face-tracking",
    "hand-tracking",
    "mediapipe",
    "webgl",
    "three",
    "ecommerce",
    "shopify",
    "vue",
    "svelte",
    "angular"
  ],
  "homepage": "https://github.com/OWNER/tryonit/tree/main/packages/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/tryonit.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/OWNER/tryonit/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/tryonit-web.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/copy-file.mjs src/mount/mount.css dist/tryonit-web.css && node ../../scripts/copy-file.mjs ../../LICENSE LICENSE",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@tryonit/core": "workspace:^"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "jsdom": "30.1.1",
    "three": "0.186.1",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
