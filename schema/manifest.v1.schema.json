  "$defs": {
    "color": {
      "type": "string",
      "description": "#RGB, #RGBA, #RRGGBB, #RRGGBBAA, rgb() or rgba()",
      "pattern": "^(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(.*\\))$"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Absolute http(s), data or blob URL, or a path relative to the manifest."
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "description": "Offset in anchor space. Position in millimeters, rotation in degrees.",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "scale": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        }
      }
    },
    "variant": {
      "type": "object",
      "required": ["id"],
      "properties": {
