    {
      "title": "makeup.lips",
      "description": "Lipstick or lip gloss.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "type", "color"],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "thumbnail": {
          "$ref": "#/$defs/url"
        },
        "defaultVariantId": {
          "type": "string",
          "minLength": 1
        },
        "meta": {
          "type": "object",
          "description": "Merchant data passthrough (sku, price). Never interpreted."
        },
        "type": {
          "const": "makeup.lips"
        },
        "variants": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/variant",
            "properties": {
              "overrides": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "$ref": "#/$defs/color"
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.6
                  },
                  "finish": {
                    "enum": ["matte", "gloss", "satin", "shimmer"],
                    "default": "matte"
                  }
                }
              }
            }
          }
        },
        "color": {
