{
  "name": "tryonit-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "TryOnIt monorepo: free, open-source, client-side virtual try-on SDK for the web and React.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . && node scripts/check-no-dashes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "publint": "pnpm -r --filter \"./packages/*\" exec publint",
    "attw": "pnpm -r --filter \"./packages/*\" exec attw --pack . --profile node16 --exclude-entrypoints styles.css",
    "e2e": "node scripts/fetch-models.mjs && node scripts/generate-sample-assets.mjs && playwright test",
    "fetch-models": "node scripts/fetch-models.mjs",
    "generate-assets": "node scripts/generate-sample-assets.mjs",
    "setup:examples": "pnpm build && pnpm fetch-models && pnpm generate-assets",
    "dev": "pnpm --filter playground dev",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm size",
    "typecheck:examples": "pnpm -r --filter \"./examples/*\" typecheck",
    "release:check": "pnpm verify && pnpm publint && pnpm attw && pnpm -r --filter \"./packages/*\" exec pnpm pack --dry-run",
    "release:publish": "pnpm -r --filter \"./packages/*\" publish --access public",
    "version:set": "node scripts/set-version.mjs",
    "validate-assets": "node packages/core/bin/tryonit-validate.mjs",
    "bundle:expo": "pnpm --filter expo-app exec expo export --platform android --platform ios --output-dir dist",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release:ci": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@size-limit/preset-small-lib": "14.1.0",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "size-limit": "14.1.0",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "size-limit": [
    {
      "name": "@tryonit/core (entire public API)",
      "path": "packages/core/dist/index.js",
      "limit": "14 KB",
      "gzip": true
    },
    {
      "name": "@tryonit/core (typical import: validate + store + resolve)",
      "path": "packages/core/dist/index.js",
      "import": "{ validateManifest, createSessionStore, resolveAsset }",
      "gzip": true,
      "limit": "8 KB"
    },
    {
      "name": "@tryonit/web (initial entry, lazy chunks excluded)",
      "path": "packages/web/dist/index.js",
      "ignore": [
        "@mediapipe/tasks-vision",
        "three",
        "@tryonit/core"
      ],
      "limit": "25 KB",
      "gzip": true
    },
    {
      "name": "@tryonit/react",
      "path": "packages/react/dist/index.js",
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@tryonit/web",
        "@tryonit/core"
      ],
      "limit": "15 KB",
      "gzip": true
    },
    {
      "name": "@tryonit/react/styles.css",
      "path": "packages/react/dist/tryonit.css",
      "limit": "6 KB",
      "rolldown": false,
      "gzip": true
    },
    {
      "name": "@tryonit/web/styles.css (mount)",
      "path": "packages/web/dist/tryonit-web.css",
      "rolldown": false,
      "limit": "3 KB",
      "gzip": true
    },
    {
      "name": "@tryonit/react-native (includes the embedded WebView runtime)",
      "path": "packages/react-native/dist/index.mjs",
      "ignore": [
        "react",
        "react-native",
        "react-native-webview",
        "react/jsx-runtime",
        "@tryonit/core"
      ],
      "gzip": true,
      "limit": "45 KB"
    }
  ]
}
